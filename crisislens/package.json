{
  "name": "crisislens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conversational investigation workbench with 模型 API, public web sources and optional local Langfuse tracing",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "langfuse:up": "docker compose -p crisislens-langfuse -f deploy/langfuse/compose.yaml --env-file deploy/langfuse/.env up -d",
    "langfuse:stop": "docker compose -p crisislens-langfuse -f deploy/langfuse/compose.yaml --env-file deploy/langfuse/.env stop",
    "langfuse:test": "node scripts/langfuse-smoke.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "investigate": "node --experimental-strip-types scripts/run-investigation.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "start": "npm run web:build && npm run serve"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@langfuse/otel": "^6.0.0",
    "@langfuse/tracing": "^6.0.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
