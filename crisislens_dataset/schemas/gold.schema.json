{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "synthetic_pending_human_review",
        "human_reviewed"
      ]
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "expected_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "hard_gate",
              "required",
              "diagnostic"
            ]
          },
          "check_mode": {
            "enum": [
              "trace",
              "human",
              "trace_and_human",
              "contract"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "severity",
          "check_mode"
        ],
        "additionalProperties": false
      }
    },
    "scoring_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "status",
    "provenance",
    "expected_facts",
    "uncertainty",
    "assertions",
    "scoring_ref"
  ],
  "additionalProperties": false
}
